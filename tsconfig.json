{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "declaration": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "paths": {
      "@kndwin/effect-auth-server": ["./packages/effect-auth-server/src/index.ts"],
      "@kndwin/effect-auth-server/*": ["./packages/effect-auth-server/src/*"],
      "@kndwin/effect-auth-client": ["./packages/effect-auth-client/src/client.ts"],
      "@kndwin/effect-auth-client/*": ["./packages/effect-auth-client/src/*"],
      "@kndwin/effect-auth-oauth": ["./packages/effect-auth-oauth/src/index.ts"],
      "@kndwin/effect-auth-oauth/github": ["./packages/effect-auth-oauth/src/github.ts"],
      "@kndwin/effect-auth-oauth/google": ["./packages/effect-auth-oauth/src/google.ts"],
      "@kndwin/effect-auth-plugin-organization": ["./packages/effect-auth-plugin-organization/src/index.ts"],
      "@kndwin/effect-auth-plugin-organization/schema": ["./packages/effect-auth-plugin-organization/src/organization.schema.ts"],
      "@kndwin/effect-auth-plugin-organization/sql": ["./packages/effect-auth-plugin-organization/src/sql.ts"],
      "@kndwin/effect-auth-plugin-organization/client": ["./packages/effect-auth-plugin-organization/src/client.ts"]
    }
  },
  "exclude": [
    "packages/effect-auth-server/src/email/templates.tsx",
    "packages/effect-auth-server/src/storage/sql.postgres.harness.ts",
    "packages/effect-auth-server/src/storage/sql.postgres.integration.ts",
    "packages/effect-auth-plugin-organization/src/organization.storage.sql.postgres.integration.ts",
    "apps/*/dev.ts"
  ]
}
