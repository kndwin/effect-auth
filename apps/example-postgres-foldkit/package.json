{
  "name": "@effect-auth/example-postgres-foldkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "server": "bun --watch server/main.ts",
    "client": "vite --config vite.config.ts",
    "dev": "bun run db:up && bun ./dev.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@effect-auth/client": "workspace:*",
    "@effect-auth/server": "workspace:*",
    "@effect/platform-bun": "4.0.0-beta.92",
    "@effect/sql-pg": "4.0.0-beta.92",
    "effect": "4.0.0-beta.92",
    "foldkit": "0.154.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.2.7"
  }
}
