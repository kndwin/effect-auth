{
  "name": "@kndwin/client",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./schema": { "types": "./dist/schema.d.ts", "import": "./dist/schema.js" },
    "./browser": { "types": "./dist/browser.d.ts", "import": "./dist/browser.js" },
    "./native": { "types": "./dist/native.d.ts", "import": "./dist/native.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.92",
    "@kndwin/server": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
