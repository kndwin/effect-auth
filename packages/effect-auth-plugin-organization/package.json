{
  "name": "@kndwin/effect-auth-plugin-organization",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./sql": {
      "types": "./dist/sql.d.ts",
      "import": "./dist/sql.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.92",
    "@kndwin/effect-auth-server": "^0.0.1"
  },
  "devDependencies": {
    "effect": "4.0.0-beta.92",
    "typescript": "^5.9.3"
  }
}
